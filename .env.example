# Copia este archivo como .env y completa. El .env NO se sube a git.

# Token del bot NUEVO de finanzas (de @BotFather). No uses el de Core Forever ni el de Deco Home.
TELEGRAM_TOKEN=123456:pega-aqui-el-token-de-BotFather

# El mismo token de Notion que usa Core Forever (esta en /opt/core-forever/.env del servidor).
NOTION_TOKEN=ntn_pega-aqui-el-token-de-tu-integracion
# ID de la pagina "Finanzas" de Notion (los 32 caracteres del final de la URL).
NOTION_PARENT_PAGE_ID=pega-aqui-los-32-caracteres-del-final-de-la-url

# Tu ID numerico de Telegram. El bot te lo dice si le escribes /id. Varios separados por coma.
# Vacio = nadie puede usarlo. A estos IDs les llegan los resumenes diario, semanal y mensual.
TELEGRAM_USUARIOS=

# Tipo de cambio inicial (despues se cambia desde el bot con /tc 3.72)
TC_USD=3.75
TC_EUR=4.10
TC_RUB=0.045

# ---------------------------------------------------------------- quien es el dueño
# Elige perfiles/<PERFIL>.py: sus categorias, sus bancos, sus alias. El codigo es el mismo
# para todos; esto es lo unico que cambia de una persona a otra.
PERFIL=jose

# La moneda en la que se suma todo. Le da el nombre a las columnas de Notion ("Monto S/",
# "Monto ₽"), asi que se define UNA VEZ antes de correr setup_notion.py y no se toca mas.
# PEN · USD · RUB · EUR
MONEDA_BASE=PEN

# A que hora vive. Decide el corte del dia y la hora de los resumenes (los timers de systemd
# la toman de aca al instalarse). America/Lima · Europe/Moscow · o algo como UTC+3
ZONA_HORARIA=America/Lima
