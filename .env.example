# Copia este archivo como .env y completa. El .env NO se sube a git.

# Token del bot NUEVO de finanzas (de @BotFather). No uses el de Core Forever ni el de Deco Home.
TELEGRAM_TOKEN=123456:pega-aqui-el-token-de-BotFather

# El mismo token de Notion que usa Core Forever (esta en /opt/core-forever/.env del servidor).
NOTION_TOKEN=ntn_pega-aqui-el-token-de-tu-integracion
# ID de la pagina "Finanzas" de Notion (los 32 caracteres del final de la URL).
NOTION_PARENT_PAGE_ID=3eb735083904812eaf30c99688fe32c3

# Tu ID numerico de Telegram. El bot te lo dice si le escribes /id. Varios separados por coma.
# Vacio = nadie puede usarlo. A estos IDs les llegan los resumenes diario, semanal y mensual.
TELEGRAM_USUARIOS=

# Tipo de cambio inicial (despues se cambia desde el bot con /tc 3.72)
TC_USD=3.75
TC_EUR=4.10
